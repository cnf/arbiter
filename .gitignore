# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.cover

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# devenv
.devenv
.devenv.flake.nix
.dirlocals
.pre-commit-config.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local env
.env
.env.local

/.claude/settings.local.json
/.claude/settings.json
/.mcp.json

# Build artifacts
dist/
build/
/arbiter

# Scratch git worktrees (a second checkout for parallel work; carries its own
# .devenv cache and its own sqlite store, neither of which belongs in git).
.worktrees/

# The event store and sqlite's journal/WAL sidecars. These are runtime state,
# not source — an errant `git add -A` from a worktree would otherwise commit
# a live database.
*.db
*.db-shm
*.db-wal

# Downloaded upstream data (price lists, model catalogues) that
# catalog-convert reads. These are fetched artifacts, large and routinely
# replaced — they belong on disk, not in git. `sources:` in the mapping file
# points at paths in here.
support/downloads/
support/design/

# secretspec's file-provider store (see devenv.yaml). Plaintext secrets —
# never commit. `keyring://` (the previous provider) kept them in a daemon
# outside the tree; the file provider has to put them somewhere.
.secrets/
